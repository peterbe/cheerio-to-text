{
  "name": "cheerio-to-text",
  "version": "0.2.9",
  "description": "Turn a Cheerio object into plain text",
  "repository": {
    "type": "git",
    "url": "git://github.com/peterbe/cheerio-to-text.git"
  },
  "bugs": {
    "url": "https://github.com/peterbe/cheerio-to-text/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/esm/index.js",
  "files": [
    "lib"
  ],
  "exports": {
    "require": "./lib/index.js",
    "import": "./lib/esm/index.js"
  },
  "scripts": {
    "test": "npm run test:test && npm run lint",
    "test:test": "node --import tsx --test test/*.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:watch": "tsc --watch",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc",
    "build:esm": "npm run build:cjs -- --module esnext --target es2019 --outDir lib/esm && echo '{\"type\":\"module\"}' > lib/esm/package.json",
    "prepare": "npm run build",
    "release": "npm run prepare && np"
  },
  "keywords": [
    "cheerio",
    "html",
    "text"
  ],
  "author": "Peter Bengtsson",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "26.1.2",
    "np": "11.2.2",
    "tsx": "4.23.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "cheerio": "1.0.0-rc.12"
  },
  "engines": {
    "node": ">=18"
  }
}
